{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Suylios Downloader",
  "version": "2.0.0",
  "identifier": "com.sayrias.suyliosdownloader",
  "build": {
    "frontendDist": "../../src/ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Suylios Downloader",
        "width": 1120,
        "height": 740,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$DOWNLOAD/**", "$HOME/**", "$APPDATA/**", "$LOCALDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../../src/ui/icon.ico"
    ],
    "resources": [
      "../../hotfixes/SUPPORTED_SITES.json",
      "../../hotfixes/dist/**/*",
      "../../src/**/*"
    ]
  }
}
